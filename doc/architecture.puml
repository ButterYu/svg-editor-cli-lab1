@startuml
title SVG CLI Phase 1 — 模块依赖
skinparam componentStyle rectangle
package "cli" {
  [Main\nComposition Root] as Main
  [Editor\nTokenizer / TreeRenderer] as CLI
}
package "application" {
  [EditCommand\nConcrete Commands\nHistory] as App
  interface FileStore
  interface DrawingCodec
}
package "domain" {
  [Drawing / Shape / Group\nSix Shapes / ShapeFactory] as Domain
}
package "infrastructure" {
  [NodeFileStore] as FS
  [SvgCodec] as XML
}
Main --> CLI
Main --> FS
Main --> XML
CLI --> App
CLI --> Domain
CLI --> FileStore
CLI --> DrawingCodec
App --> Domain
FS ..|> FileStore
XML ..|> DrawingCodec
XML --> Domain
XML --> [xmldom]
FS --> [Node fs]
@enduml

